{
  "name": "the-bot-problem",
  "version": "0.0.0",
  "private": true,
  "description": "A turn-based platformer that LLM bots play together, plus a replay viewer for watching what happened.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "keys": "tsx harness/cli/keys.ts",
    "check-env": "tsx harness/cli/checkEnv.ts",
    "prices": "tsx harness/cli/prices.ts",
    "estimate": "tsx harness/cli/estimate.ts",
    "fake-run": "tsx harness/cli/fakeRun.ts",
    "levels": "tsx harness/cli/levels.ts",
    "format-test": "tsx harness/cli/formatTest.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@inquirer/password": "^5.3.0",
    "@napi-rs/canvas": "^1.1.1",
    "zod": "^4.6.7"
  }
}
