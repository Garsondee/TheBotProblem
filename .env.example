# API keys for the bots. The easy way to fill these in: run `npm run keys`
# (it asks for each key without showing it on screen and writes .env for you).
#
# Or copy this file to .env and paste each key after its = sign.
# .env is git-ignored. Never commit it and never paste keys anywhere else.
# A missing key is fine: those seats simply run as the free MockAgent.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
