{
  // The viewer runs in the browser, so it gets the DOM's types. It shares the
  // engine with the game (the engine is pure code), so the engine is checked
  // here too, against the browser's library.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "../engine", "../game/events.ts"]
}
